# BotFather bergan token
TELEGRAM_BOT_TOKEN=123456789:AAA-BBB-CCC

# Webhook maxfiy kaliti (yangisini olish: npm run secret)
WEBHOOK_SECRET=

# Serverning HTTPS domeni, oxirida / belgisisiz
PUBLIC_URL=https://bot.example.com

# Server ichki porti (nginx shu portga proxy qiladi)
PORT=3000

NODE_ENV=production

# Ixtiyoriy: ma'lumot papkasi (standart — loyihadagi data/)
# DATA_DIR=/var/lib/telegram-bot

# Ixtiyoriy: Bot API manzili (lokal Bot API serveri yoki sinov uchun)
# TELEGRAM_API_BASE=https://api.telegram.org

# --- AI ---
# Claude API kaliti: https://console.anthropic.com/settings/keys
# Bo'sh qoldirilsa bot ishlayveradi, lekin suhbat qismi o'chiq bo'ladi.
ANTHROPIC_API_KEY=

# Ixtiyoriy: model va fikrlash chuqurligi
# AI_MODEL=claude-opus-5
# AI_EFFORT=medium          # low | medium | high | xhigh | max
# AI_MAX_TOKENS=8000
# AI_TIMEOUT_MS=120000

# Veb qidiruv: model kerak bo'lganda internetdan ma'lumot oladi.
# Diqqat — qidiruvli savol oddiy savoldan sezilarli qimmat: natijalar modelga
# kirish tokeni bo'lib qaytadi. O'chirish uchun: AI_WEB_SEARCH=off
# AI_WEB_SEARCH=on
# AI_WEB_SEARCH_MAX_USES=5   # bitta javobda nechta qidiruvga ruxsat (1-20)

# Bilim bazasi: model shu papkadagi .md va .txt fayllardan qidiradi.
# Papka bo'sh yoki yo'q bo'lsa vosita modelga e'lon qilinmaydi — bot ishlayveradi.
# BILIM_DIR=bilim
# BILIM_MAX_RESULTS=4        # bitta qidiruvda nechta parcha beriladi (1-10)

# Agentlar: yozuvchi va muharrirning xarakter fayllari shu papkada turadi.
# Fayllarni tahrirlash uchun restart kerak emas — mtime kuzatiladi.
# AGENTLAR_DIR=agentlar
# AGENT_MAX_REWRITES=2       # muharrir rozi bo'lmasa nechta qayta yozishga ruxsat (0-5)

# Kover rasm: post uchun muqova. Kalit bo'lmasa xato emas — shablon kover
# lokal chiziladi (gradient fon + sarlavha + ism), narxi nol.
# KOVER=on
# KOVER_API_KEY=            # aistudio.google.com dan olingan kalit
# KOVER_MODEL=gemini-3.1-flash-image
# KOVER_TIMEOUT_MS=60000
# KOVER_BRAND=Mrxone        # shablon koverning pastiga yoziladigan ism
